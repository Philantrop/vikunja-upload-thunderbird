{
  "manifest_version": 2,
  "name": "Vikunja Uploader",
  "version": "1.0.0",
  "description": "Create tasks in Vikunja directly from emails with attachments, labels, priorities, and due dates",
  "applications": {
    "gecko": {
      "id": "@vikunja-uploader.thunderbird",
      "strict_min_version": "91.0"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "permissions": [
    "messagesRead",
    "menus",
    "notifications",
    "storage",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "message_display_action": {
    "default_title": "Vikunja Uploader",
    "default_popup": "message-display-popup.html",
    "default_icon": "icons/icon-32.png"
  },
  "browser_action": {
    "default_title": "Vikunja Uploader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "128": "icons/icon-128.png",
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png"
  }
}
